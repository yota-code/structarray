#!/usr/bin/env python3

import argparse

from cc_pathlib import Path

import structarray

parser = argparse.ArgumentParser(description='Convert a meta (*.sam.tsv) and data (*.sad.bin) file into a tsv file')

parser.add_argument('--meta', '-m', metavar='META', default=None, type=Path, help='the meta (*.tsv) file')
parser.add_argument('data', metavar='DATA', type=Path, help='the data (*.reb) file')

args = parser.parse_args()

structarray.open(args.data, args.meta).to_hdf5()

